# --- Database (Neon) ---
# Pooled connection string (host contains "-pooler") - used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/meow?sslmode=require"
# Direct (non-pooled) connection string - used by `prisma migrate`. Same as above without "-pooler".
# Optional: falls back to DATABASE_URL, but migrations can hang on a pooled connection.
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/meow?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Google OAuth (optional - Google button hides when empty)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Cloudinary (signed uploads) ---
# When empty, the sell form falls back to pasting image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Email (Resend) - optional, logs to console when empty ---
RESEND_API_KEY=""
EMAIL_FROM="Meow <no-reply@meow.com.bd>"

# --- SMS gateway (generic HTTP gateway) - optional, logs OTP to console when empty ---
# The URL may contain {to} and {message} placeholders, e.g.
# https://sms.example.com/api/send?api_key=XXX&to={to}&msg={message}
SMS_GATEWAY_URL=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma separated emails that become admin on first sign-up / seed
ADMIN_EMAILS="admin@meow.com.bd"
